CompileFlags:
  QueryDriver:
    - /usr/bin/arm-none-eabi-gcc
    - /usr/bin/arm-none-eabi-g++

---
If:
  PathMatch: software/stm32g431/.*
CompileFlags:
  CompilationDatabase: software/stm32g431/build/Debug

---
If:
  PathMatch: software/stm32f411/.*
CompileFlags:
  CompilationDatabase: software/stm32f411/build/Debug

# Shared BSP: route board-specific trees to the matching firmware project DB
---
If:
  PathMatch: software/shared/bsp/boards/stm32g431/.*
CompileFlags:
  CompilationDatabase: software/stm32g431/build/Debug

---
If:
  PathMatch: software/shared/bsp/boards/stm32f411/.*
CompileFlags:
  CompilationDatabase: software/stm32f411/build/Debug

# Generic shared BSP sources (bsp.c, bsp.h) — default to G431 firmware context
---
If:
  PathMatch: software/shared/.*
CompileFlags:
  CompilationDatabase: software/stm32g431/build/Debug