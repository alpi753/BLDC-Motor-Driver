{
    "configurations": [
        {
            "name": "Firmware (STM32G431)",
            "includePath": [
                "${workspaceFolder}/software/stm32g431/**",
                "${workspaceFolder}/software/shared/**",
                "${workspaceFolder}/software/stm32g431/build/Debug/generated"
            ],
            "defines": [
                "DEBUG",
                "STM32G431xx",
                "USE_HAL_DRIVER"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm",
            "compileCommands": "${workspaceFolder}/software/stm32g431/build/Debug/compile_commands.json",
            "browse": {
                "path": [
                    "${workspaceFolder}/software/stm32g431",
                    "${workspaceFolder}/software/shared"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
